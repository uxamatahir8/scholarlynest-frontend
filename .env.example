# ScholarlyNest Next.js UI Environment Variables Template

# Base API URL of the Laravel Backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Next.js server port and public frontend URL
PORT=3000
APP_URL_FRONTEND=http://localhost:3000

# OAuth client credentials for Google sign in/up
NEXT_PUBLIC_GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
